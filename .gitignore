# Dependency directories
node_modules/
jspm_packages/

# Build outputs
dist/
build/
.cache/
out/

# Base de données locale PGlite (ne doit jamais être versionnée)
db_data/
db_data.cloned-backup/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System files
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/

# Outillage agent : le personnel reste local, mais le garde-fou navigateur et la
# config des serveurs de dev DOIVENT être versionnés — sinon la protection décrite
# dans CLAUDE.md n'existe plus sur un clone frais.
.claude/*
!.claude/settings.json
!.claude/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
