# =============================================================================
# Configuration du backend Balance
# Copiez ce fichier en `.env` puis adaptez les valeurs.
# =============================================================================

# Environnement : "development" (PGlite local) ou "production" (PostgreSQL)
NODE_ENV=development

# Port et hôte d'écoute du serveur Fastify (défauts : 3006 / 0.0.0.0).
# LAISSEZ CES DEUX LIGNES COMMENTÉES sur AlwaysData : PORT et HOST sont prioritaires
# sur ALWAYSDATA_HTTPD_PORT/IP, donc les définir empêcherait le serveur d'écouter
# là où AlwaysData l'attend.
# PORT=3006
# HOST=0.0.0.0

# --- Production uniquement ---
# Chaîne de connexion PostgreSQL (ex. AlwaysData). Requise si NODE_ENV=production.
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/balance

# Secret de signature des jetons JWT.
# OBLIGATOIRE en production (le serveur refuse de démarrer sans).
# Générez une valeur forte, ex. : openssl rand -base64 48
JWT_SECRET=remplacez-moi-par-un-secret-aleatoire-long

# Origine autorisée pour le CORS (URL du frontend).
# INUTILE en mode « 1 seul site » (le backend sert le frontend -> même origine).
# À définir UNIQUEMENT si le frontend est hébergé sur une autre origine.
# Ex. : https://balance.mondomaine.fr
# CORS_ORIGIN=https://balance.mondomaine.fr

# Optionnel : chemin du build frontend à servir (défaut : ../frontend/dist
# relatif au backend). Utile si le frontend est buildé ailleurs.
# FRONTEND_DIST=/chemin/vers/frontend/dist

# --- Envoi automatique des pesées vers l'app fitness (AC-KINETIK) ---
# Les TROIS variables sont requises pour activer l'intégration ; s'il en manque une,
# rien n'est envoyé (aucune erreur, la pesée s'enregistre normalement).
#
# Endpoint d'ingestion d'AC-KINETIK.
# FITNESS_SYNC_URL=https://ac-kinetik.alwaysdata.net/api/integrations/balance/weigh-in
#
# Secret PARTAGÉ avec AC-KINETIK (variable BALANCE_SYNC_SECRET là-bas) : il signe chaque
# poussée en HMAC-SHA256. Doit être IDENTIQUE des deux côtés.
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FITNESS_SYNC_SECRET=
#
# Comptes Balance dont les pesées partent vers l'app fitness (emails, séparés par des
# virgules). Doit correspondre à ADMIN_EMAILS côté AC-KINETIK, qui refuse tout le reste.
# FITNESS_SYNC_EMAILS=moi@exemple.fr
